---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Mustafa Alnagdy | Data Science, AI & Process Systems',
  description = 'Mustafa Alnagdy builds AI agents and machine-learning systems for industrial data, combining data science with process-engineering domain knowledge.',
  image = '/images/projects/image-analysis-agent/03-analysis-result.webp',
  imageAlt = 'Image Analysis Agent interface showing structured AI-generated product tags',
  type = 'website',
} = Astro.props;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageUrl = Astro.site ? new URL(image, Astro.site) : undefined;
const personSchema = canonicalUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Mustafa Abdel-Rahman Alnagdy',
      url: canonicalUrl.origin,
      sameAs: [
        'https://www.linkedin.com/in/mustafa-alnagdy',
        'https://github.com/Nagdy8888',
      ],
      knowsAbout: [
        'Data Science',
        'Machine Learning',
        'AI Agents',
        'Process Engineering',
        'Industrial Analytics',
      ],
    }
  : undefined;
---

<!DOCTYPE html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mustafa Alnagdy" />
    <meta name="theme-color" content="#172554" />
    <meta name="color-scheme" content="light dark" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Mustafa Alnagdy Portfolio" />
    <meta property="og:locale" content="en_US" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {personSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var useDark = stored === 'dark' || (stored !== 'light' && prefersDark);
          document.documentElement.classList.toggle('dark', useDark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans bg-[var(--color-bg)] text-[var(--color-text)] antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
    <script is:inline>
      document.documentElement.classList.remove('no-js');

      function initPage() {
        var themeBtn = document.getElementById('theme-toggle');

        function updateThemeControl() {
          var isDark = document.documentElement.classList.contains('dark');
          var darkIcon = document.querySelector('.theme-icon-dark');
          var lightIcon = document.querySelector('.theme-icon-light');
          if (darkIcon) darkIcon.classList.toggle('hidden', isDark);
          if (lightIcon) lightIcon.classList.toggle('hidden', !isDark);
          if (themeBtn) themeBtn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        }

        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var isDark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
            updateThemeControl();
          });
          updateThemeControl();
        }

        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.animate-on-scroll').forEach(function (el) {
            el.classList.add('animate-visible');
          });
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('animate-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        document.querySelectorAll('.animate-on-scroll').forEach(function (el) {
          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPage);
      } else {
        initPage();
      }
    </script>
  </body>
</html>
