---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import { projects } from '../../data/projects';
import { dimensionsFor } from '../../data/imageDimensions';
export function getStaticPaths() { return projects.map(project => ({params:{slug:project.slug},props:{project}})); }
const { project } = Astro.props;
const related = projects.filter(p => p.slug !== project.slug && p.image).slice(0,2);
const isRag = project.slug === 'smart-rag';
---
<Layout title={`${project.title} | Mustafa Alnagdy`} description={project.shortDescription} image={project.image} imageAlt={project.imageAlt} type="article"><Navbar /><main id="main-content" class="case-main"><div class="wrap"><a href="/projects" class="back-link"> All projects</a><div class="case-heading"><div><h1>{project.title}</h1><p>{project.shortDescription}</p></div><div class="case-facts"><div><span>Discipline</span><strong>{project.categories.join(' / ')}</strong></div><div><span>My role</span><strong>{project.role ?? 'Design & development'}</strong></div><div><span>Timeline</span><strong>{project.dateLabel ?? project.year}</strong></div><div><span>Focus</span><strong>{project.scope ?? project.categories.join(', ')}</strong></div></div></div><div class="inline-tags case-tags">{project.tags.slice(0, 6).map(tag => <span>{tag}</span>)}</div>
{project.image && <a class="case-cover gallery-trigger" href={project.image} data-image={project.image} data-width={dimensionsFor(project.image).width} data-height={dimensionsFor(project.image).height} data-alt={project.imageAlt ?? project.title} aria-label={`Enlarge ${project.title} screenshot`}><img src={project.image} alt={project.imageAlt ?? project.title} width={dimensionsFor(project.image).width} height={dimensionsFor(project.image).height} loading="eager" /><span class="enlarge-label">View full size </span></a>}
<div class="case-body"><aside class="case-outline" aria-label="Case study sections"><a href="#overview">Overview</a><a href="#challenge">The challenge</a><a href="#approach">The approach</a><a href="#outcome">The outcome</a>{project.screenshots && <a href="#gallery">In the product</a>}{project.diagrams?.length ? <a href="#architecture">Architecture</a> : null}</aside><div class="case-prose"><section id="overview"><h2>The idea behind it.</h2><p>{project.fullDescription}</p></section><section id="challenge"><h2>The challenge</h2><p>{project.problem ?? project.shortDescription}</p></section><section id="approach"><h2>The approach</h2><p>{project.approach ?? project.fullDescription}</p>{isRag && <div class="rag-flow" aria-label="Document answer pipeline"><div><strong>Retrieve</strong><span>Semantic + keyword + exact terms</span></div><div><strong>Ground</strong><span>Authorized passages + verification</span></div><div><strong>Inspect</strong><span>Answer + original PDF evidence</span></div></div>}</section><section id="outcome"><h2>What it delivers</h2><p>{project.results ?? project.keyResult ?? project.fullDescription}</p>{project.metrics && <dl class="case-metrics">{project.metrics.map(metric => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>}{isRag && <div class="case-note"><strong>Current status</strong><p>In final development and evaluation. Screenshots are from the running local application. Final release acceptance is still in progress.</p></div>}</section><section id="tools"><h2>Built with</h2><div class="inline-tags">{(project.tools ?? project.tags).map(tool => <span>{tool}</span>)}</div></section>{(project.github || project.liveUrl) && <div class="case-links">{project.github && <a class="button button-dark" href={project.github} target="_blank" rel="noopener noreferrer">View source </a>}{project.liveUrl && <a class="text-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">Open live demo </a>}</div>}{project.availabilityNote && <p class="case-note">{project.availabilityNote}</p>}</div></div>
{project.screenshots && <section id="gallery" class="case-gallery"><div class="section-heading"><h2>Inside the product.</h2><p>Real interfaces. Click to take a closer look.</p></div>{project.screenshots.map((src,index) => <figure><a class="gallery-trigger" href={src} data-image={src} data-width={dimensionsFor(src).width} data-height={dimensionsFor(src).height} data-alt={project.screenshotAlts?.[index] ?? project.title} aria-label={`Enlarge ${project.screenshotAlts?.[index] ?? project.title}`}><img src={src} alt={project.screenshotAlts?.[index] ?? project.title} width={dimensionsFor(src).width} height={dimensionsFor(src).height} loading="lazy" /><span class="enlarge-label">View full size </span></a><figcaption>{project.screenshotAlts?.[index] ?? `${project.title} — product interface`}</figcaption></figure>)}</section>}
{project.diagrams && project.diagrams.length > 0 && <section id="architecture" class="case-gallery architecture-section"><div class="section-heading"><h2>How it fits together.</h2><p>The system, the answer flow, and the evidence behind it.</p></div>{project.diagrams.map((diagram, index) => <ArchitectureDiagram diagram={diagram} index={index} />)}</section>}

<section class="case-related"><div class="section-heading"><h2>Keep exploring.</h2><a class="text-link" href="/projects">All projects </a></div><div class="selected-grid">{related.map(item => <article><a class="selected-image" href={`/projects/${item.slug}`}><img src={item.image} alt={item.imageAlt ?? item.title} width="1200" height="675" loading="lazy" /></a><h3><a href={`/projects/${item.slug}`}>{item.title} </a></h3></article>)}</div></section>
</div><div class="case-cta"><div class="wrap"><h2>Let’s build something useful.</h2><a class="button button-dark" href="mailto:mustafaalnagdy26@gmail.com">Get in touch </a></div></div></main><Footer />
<dialog id="image-dialog" class="image-dialog" aria-label="Project screenshot viewer"><div class="dialog-toolbar"><span id="dialog-caption"></span><div class="dialog-actions"><button type="button" id="zoom-image-dialog" aria-pressed="false">Original size</button><a id="open-original-image" href={project.image ?? "/images/mustafa-alnagdy.webp"} target="_blank" rel="noopener noreferrer">Open original</a><button type="button" id="close-image-dialog" aria-label="Close screenshot viewer">Close</button></div></div><div class="dialog-image-canvas" tabindex="0" role="region" aria-label="Screenshot image; scroll to inspect when viewing original size"><img id="dialog-image" src={project.image ?? "/images/mustafa-alnagdy.webp"} alt={project.imageAlt ?? project.title} width={dimensionsFor(project.image ?? "/images/mustafa-alnagdy.webp").width} height={dimensionsFor(project.image ?? "/images/mustafa-alnagdy.webp").height} /></div></dialog>
</Layout>
<script>
const dialog = document.querySelector<HTMLDialogElement>('#image-dialog');
const image = document.querySelector<HTMLImageElement>('#dialog-image');
const caption = document.getElementById('dialog-caption');
let opener: HTMLElement | null = null;
const zoom = document.querySelector<HTMLButtonElement>('#zoom-image-dialog');
const original = document.querySelector<HTMLAnchorElement>('#open-original-image');
function setOriginalSize(enabled: boolean) {
  dialog?.classList.toggle('is-zoomed', enabled);
  zoom?.setAttribute('aria-pressed', String(enabled));
  if (zoom) zoom.textContent = enabled ? 'Fit to screen' : 'Original size';
}
document.querySelectorAll<HTMLAnchorElement>('.gallery-trigger').forEach(anchor => anchor.addEventListener('click', event => {
  if (!dialog?.showModal || !image || !anchor.dataset.image) return;
  // Preserve native open-in-new-tab gestures and non-JavaScript image access.
  if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
  event.preventDefault();
  opener = anchor;
  image.src = anchor.dataset.image;
  image.alt = anchor.dataset.alt ?? '';
  image.width = Number(anchor.dataset.width);
  image.height = Number(anchor.dataset.height);
  if (original) original.href = anchor.href;
  if (caption) caption.textContent = image.alt;
  setOriginalSize(false);
  dialog.showModal();
  document.body.style.overflow = 'hidden';
}));
zoom?.addEventListener('click', () => setOriginalSize(zoom.getAttribute('aria-pressed') !== 'true'));
document.getElementById('close-image-dialog')?.addEventListener('click', () => dialog?.close());
dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
dialog?.addEventListener('close', () => { document.body.style.overflow = ''; opener?.focus(); });
</script>
