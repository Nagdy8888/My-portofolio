---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { projects, categoryToBadgeClass } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const hasStructuredContent = project.problem || project.approach || project.results;

function toSentences(text: string): string[] {
  return text
    .split(/(?<=\.)\s+/)
    .map((s) => s.trim())
    .filter((s) => s.length > 0);
}
---

<Layout
  title={`${project.title} | Mustafa Alnagdy`}
  description={project.shortDescription}
  image={project.image}
  imageAlt={project.imageAlt}
  type="article"
>
  <Navbar />
  <main id="main-content" class="py-16 md:py-20 bg-[var(--color-bg)]">
    <div class="max-w-[800px] mx-auto px-6">
      <a href="/projects" class="text-sm text-[var(--color-primary)] hover:underline mb-6 inline-block">&larr; Back to All Projects</a>

      <div class="flex flex-wrap gap-1.5 mb-4">
        {project.categories.map((cat) => (
          <span class={`inline-block text-xs font-medium px-2.5 py-1 rounded-full ${categoryToBadgeClass(cat)}`}>{cat}</span>
        ))}
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-4">{project.title}</h1>
      {(project.dateLabel || project.role) && (
        <p class="mb-5 text-sm text-[var(--color-text-light)]">
          {[project.role, project.dateLabel].filter(Boolean).join(' · ')}
        </p>
      )}
      <p class="mb-6 text-lg leading-relaxed text-[var(--color-text-light)]">{project.fullDescription}</p>

      {(project.scope || (project.metrics && project.metrics.length > 0)) && (
        <section class="mb-8 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-5" aria-label="Project overview">
          {project.scope && (
            <div class="mb-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-light)]">Scope</p>
              <p class="mt-1 text-sm font-medium text-[var(--color-text)]">{project.scope}</p>
            </div>
          )}
          {project.metrics && project.metrics.length > 0 && (
            <dl class="grid gap-4 sm:grid-cols-2">
              {project.metrics.map((metric) => (
                <div>
                  <dt class="text-xs text-[var(--color-text-light)]">{metric.label}</dt>
                  <dd class="mt-1 text-xl font-bold text-[var(--color-primary)]">{metric.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </section>
      )}

      <div class="flex flex-wrap gap-2 mb-6">
        {project.tags.map((tag) => (
          <span class="tag-pill text-xs font-medium px-3 py-1 rounded-full">{tag}</span>
        ))}
      </div>

      {project.screenshots && project.screenshots.length > 0 ? (
        <div class="screenshot-gallery mb-8" id="screenshot-gallery">
          {project.screenshots.map((src, i) => (
            <button
              type="button"
              class="screenshot-card"
              data-lightbox-src={src}
              data-lightbox-alt={project.screenshotAlts?.[i] ?? `${project.title} screenshot ${i + 1}`}
              aria-label={`Open ${project.screenshotAlts?.[i] ?? `${project.title} screenshot ${i + 1}`} full size`}
            >
              <img
                src={src}
                alt={project.screenshotAlts?.[i] ?? `${project.title} screenshot ${i + 1}`}
                width="1912"
                height="977"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="w-full h-auto object-contain"
              />
            </button>
          ))}
        </div>
      ) : project.image ? (
        <div class="mb-8 rounded-md overflow-hidden border border-[var(--color-border)] shadow-md">
          <img
            src={project.image}
            alt={project.imageAlt ?? `${project.title} project visual`}
            width={project.imageWidth ?? 1200}
            height={project.imageHeight ?? 675}
            decoding="async"
            class="w-full h-auto object-cover"
          />
        </div>
      ) : null}

      <div id="screenshot-lightbox" class="screenshot-lightbox" role="dialog" aria-modal="true" aria-label="Project visual full size" tabindex="-1" hidden>
        <button type="button" class="screenshot-lightbox-backdrop" aria-label="Close"></button>
        <div class="screenshot-lightbox-content">
          <img id="screenshot-lightbox-img" src="" alt="Project visual full size" />
          <button type="button" class="screenshot-lightbox-close" aria-label="Close">&times;</button>
        </div>
      </div>

      <script>
        const lightbox = document.getElementById('screenshot-lightbox');
        const lightboxImg = document.getElementById('screenshot-lightbox-img');
        const backdrop = lightbox?.querySelector('.screenshot-lightbox-backdrop');
        const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.screenshot-lightbox-close');
        let screenshotTrigger: HTMLElement | null = null;

        function openLightbox(src: string, alt: string, trigger: HTMLElement) {
          if (!lightbox || !lightboxImg) return;
          screenshotTrigger = trigger;
          lightboxImg.setAttribute('src', src);
          lightboxImg.setAttribute('alt', alt);
          lightbox.removeAttribute('hidden');
          document.body.style.overflow = 'hidden';
          closeBtn?.focus();
        }

        function closeLightbox() {
          if (!lightbox) return;
          lightbox.setAttribute('hidden', '');
          document.body.style.overflow = '';
          screenshotTrigger?.focus();
          screenshotTrigger = null;
        }

        document.querySelectorAll<HTMLElement>('[data-lightbox-src]').forEach((card) => {
          card.addEventListener('click', () => {
            const src = card.getAttribute('data-lightbox-src');
            const alt = card.getAttribute('data-lightbox-alt') ?? 'Project visual';
            if (src) openLightbox(src, alt, card);
          });
        });

        backdrop?.addEventListener('click', closeLightbox);
        closeBtn?.addEventListener('click', closeLightbox);

        lightbox?.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Escape') closeLightbox();
          if (e.key !== 'Tab' || !lightbox) return;
          const focusable = Array.from(
            lightbox.querySelectorAll<HTMLElement>('button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])')
          );
          if (focusable.length === 0) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });

        async function renderMermaidDiagrams() {
          const containers = document.querySelectorAll<HTMLElement>('[data-mermaid-diagram]');
          if (containers.length === 0) return;

          try {
            const { default: mermaid } = await import('mermaid');
            mermaid.initialize({
              startOnLoad: false,
              securityLevel: 'strict',
              theme: document.documentElement.classList.contains('dark') ? 'dark' : 'neutral',
            });

            for (const [index, container] of Array.from(containers).entries()) {
              const data = container.querySelector('script[type="application/json"]');
              if (!data?.textContent) continue;
              const definition = JSON.parse(data.textContent);
              if (typeof definition !== 'string') continue;
              const id = `portfolio-mermaid-${index}-${Math.random().toString(36).slice(2, 8)}`;
              const { svg } = await mermaid.render(id, definition);
              container.innerHTML = svg;
            }
          } catch (error) {
            console.warn('Mermaid diagram rendering failed; showing the static fallback.', error);
          }
        }

        renderMermaidDiagrams();
      </script>

      {hasStructuredContent ? (
        <div class="space-y-8 mb-8">
          {project.problem && (
            <section>
              <h2 class="text-xl font-semibold text-[var(--color-text)] mb-2">The Problem</h2>
              {toSentences(project.problem).length > 1 ? (
                <ul class="project-bullets">
                  {toSentences(project.problem).map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              ) : (
                <p class="text-base leading-relaxed text-[var(--color-text-light)]">{project.problem}</p>
              )}
            </section>
          )}
          {project.approach && (
            <section>
              <h2 class="text-xl font-semibold text-[var(--color-text)] mb-2">Approach</h2>
              {toSentences(project.approach).length > 1 ? (
                <div class="project-graph" role="img" aria-label="Approach steps as a flowchart">
                  {toSentences(project.approach).map((s, i) => {
                    const steps = toSentences(project.approach ?? '');
                    return (
                      <>
                        <div class="graph-node">{s}</div>
                        {i < steps.length - 1 ? <div class="graph-connector" aria-hidden="true" /> : null}
                      </>
                    );
                  })}
                </div>
              ) : (
                <p class="text-base leading-relaxed text-[var(--color-text-light)]">{project.approach}</p>
              )}
            </section>
          )}
          {project.results && (
            <section>
              <h2 class="text-xl font-semibold text-[var(--color-text)] mb-2">Results</h2>
              {toSentences(project.results).length > 1 ? (
                <ul class="project-checks">
                  {toSentences(project.results).map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              ) : (
                <p class="text-base leading-relaxed text-[var(--color-text-light)]">{project.results}</p>
              )}
              {project.keyResult && (
                <div class="project-callout mt-4">
                  <strong>Key result:</strong> {project.keyResult}
                </div>
              )}
            </section>
          )}
        </div>
      ) : (
        <div class="mb-8">
          {project.keyResult && (
            <div class="project-callout mt-4">
              <strong>Key result:</strong> {project.keyResult}
            </div>
          )}
        </div>
      )}

      {project.diagrams && project.diagrams.length > 0 && (
        <section class="mb-8" aria-labelledby="diagrams-heading">
          <h2 id="diagrams-heading" class="text-xl font-semibold text-[var(--color-text)] mb-4">Architecture &amp; Flows</h2>
          <p class="mb-5 leading-relaxed text-[var(--color-text-light)]">
            The system connects Next.js clients to FastAPI, a LangGraph tagging pipeline,
            OpenAI GPT-4o, and Supabase PostgreSQL.
          </p>
          <div class="space-y-8">
            {project.diagrams.map((diagram) => (
              <figure>
                <h3 class="mb-3 text-lg font-medium text-[var(--color-text)]">{diagram.title}</h3>
                <button
                  type="button"
                  data-lightbox-src={diagram.image}
                  data-lightbox-alt={diagram.alt}
                  class="block w-full cursor-zoom-in overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-0 text-left transition-colors hover:border-[var(--color-primary)]"
                  aria-label={`Open ${diagram.title} diagram full size`}
                >
                  <div class="mermaid-diagram" data-mermaid-diagram role="img" aria-label={diagram.alt}>
                    <script is:inline type="application/json" set:html={JSON.stringify(diagram.mermaid).replace(/<\/script>/gi, '<\\/script>')} />
                    <img
                      src={diagram.image}
                      alt={diagram.alt}
                      width={diagram.width}
                      height={diagram.height}
                      loading="lazy"
                      decoding="async"
                      class="h-auto w-full"
                    />
                  </div>
                </button>
                <figcaption class="mt-2 text-sm text-[var(--color-text-light)]">
                  Select the architecture diagram to inspect it full size.
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      {project.tools && project.tools.length > 0 && (
        <section class="mb-8">
          <h2 class="text-xl font-semibold text-[var(--color-text)] mb-3">Tools Used</h2>
          <div class="flex flex-wrap gap-2">
            {project.tools.map((tool) => (
              <span class="text-sm bg-[var(--color-bg-alt)] text-[var(--color-text-light)] px-3 py-1.5 rounded-md border border-[var(--color-border)]">{tool}</span>
            ))}
          </div>
        </section>
      )}

      <div class="flex flex-wrap gap-4">
        {project.github && (
          <a href={project.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white dark:text-slate-950 px-5 py-2.5 rounded-md font-medium hover:bg-[var(--color-primary-hover)] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>View on GitHub</span>
          </a>
        )}
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border-2 border-[var(--color-primary)] text-[var(--color-primary)] px-5 py-2.5 rounded-md font-medium hover:bg-[var(--color-primary)] hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            <span>Live Demo</span>
          </a>
        )}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
