---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { projectsByRecent } from '../../data/projects';
const categories = Array.from(new Set(projectsByRecent.flatMap(p => p.categories))).sort();
---
<Layout title="Selected Work | Mustafa Alnagdy" description="Explore AI agents, document intelligence, workflow automation, and industrial machine-learning projects by Mustafa Alnagdy."><Navbar /><main id="main-content" class="archive-main wrap"><a href="/" class="back-link"> Back to home</a><div class="archive-heading"><h1>Ideas, built out.</h1><p>AI agents, useful automations, and machine learning grounded in real systems. Explore the work and the thinking behind it.</p></div><div class="archive-filters" role="group" aria-label="Filter projects by category"><button class="filter-button" data-filter="all" aria-pressed="true">All work</button>{categories.map(category => <button class="filter-button" data-filter={category} aria-pressed="false">{category}</button>)}</div><p id="project-filter-status" class="filter-status" aria-live="polite">Showing all {projectsByRecent.length} projects</p><div class="archive-grid">{projectsByRecent.map(project => <article class:list={["archive-project", { "archive-project-text": !project.image }]} data-categories={JSON.stringify(project.categories)}>{project.image && <a class="archive-visual" href={`/projects/${project.slug}`} aria-label={`View ${project.title} case study`}><img src={project.image} alt={project.imageAlt ?? project.title} width={project.imageWidth ?? 1200} height={project.imageHeight ?? 675} loading="lazy" /></a>}<div class="project-meta"><span>{project.categories.join(' / ')}</span><span>{project.dateLabel ?? project.year}</span></div><h2><a href={`/projects/${project.slug}`}>{project.title}</a></h2><p>{project.shortDescription}</p><div class="inline-tags">{project.tags.slice(0,4).map(tag => <span>{tag}</span>)}</div></article>)}</div><div class="archive-close"><h2>Have something in mind?</h2><a class="text-link" href="/#contact">Let’s talk about it </a></div></main><Footer /></Layout>
<script>
const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
const cards = [...document.querySelectorAll<HTMLElement>('.archive-project')];
const status = document.getElementById('project-filter-status');
function applyFilter(requested: string, updateUrl = false) {
  const filter = buttons.some(button => button.dataset.filter === requested) ? requested : 'all';
  let visible = 0;
  buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === filter)));
  cards.forEach(card => {
    const show = filter === 'all' || JSON.parse(card.dataset.categories ?? '[]').includes(filter);
    card.hidden = !show;
    if (show) visible++;
  });
  if (status) status.textContent = filter === 'all' ? `Showing all ${visible} projects` : `Showing ${visible} ${filter} ${visible === 1 ? 'project' : 'projects'}`;
  if (updateUrl) {
    const url = new URL(window.location.href);
    if (filter === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', filter);
    window.history.pushState(null, '', url);
  }
}
buttons.forEach(button => button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all', true)));
window.addEventListener('popstate', () => applyFilter(new URLSearchParams(location.search).get('category') ?? 'all'));
applyFilter(new URLSearchParams(location.search).get('category') ?? 'all');
</script>
