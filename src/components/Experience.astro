---
const internships = [
  { logo: '/images/onspec_engineering_solutions_logo.jpeg', company: 'Onspec Engineering', role: 'Process Engineering Intern', dates: 'Aug 2024', summary: 'Built unsteady-state Aspen HYSYS simulations and evaluated pump behavior and performance calculations.' },
  { logo: '/images/enppi_logo.jpeg', company: 'ENPPI', role: 'Process Engineering Intern', dates: 'Jul 2024', summary: 'Studied process equipment, operating practice, and safety protocols for industrial facilities.' },
  { logo: '/images/onspec_engineering_solutions_logo.jpeg', company: 'Onspec Engineering', role: 'Process Engineering Intern', dates: 'Aug – Sep 2023', summary: 'Analyzed system and utility flow diagrams and practiced steady-state process simulation.' },
  { logo: '/images/petrojet_logo.jpeg', company: 'Petrojet', role: 'Process Engineering Intern', dates: 'Jul – Aug 2023', summary: 'Designed and interpreted BFD, PFD, and P&ID documentation using AutoCAD.' },
];
---

<section id="experience" class="py-16 md:py-20 bg-[var(--color-bg)] animate-on-scroll">
  <div class="max-w-[1100px] mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-2">Experience</h2>
    <div class="section-underline mb-8"></div>

    <article class="mb-10 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-md md:p-8">
      <div class="mb-5 flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
        <div class="flex items-center gap-4">
          <img src="/images/MIS.jpeg" alt="MIS logo" width="200" height="200" loading="lazy" class="h-12 w-12 rounded-md object-contain" />
          <div>
            <p class="mb-1 text-sm font-semibold text-[var(--color-primary)]">MIS</p>
            <h3 class="text-xl font-semibold text-[var(--color-text)]">AI Agents &amp; Automation Intern</h3>
          </div>
        </div>
        <p class="text-sm text-[var(--color-text-light)]">Aug 2025 – Present</p>
      </div>
      <ul class="project-checks">
        <li>Deploying LangGraph PO Parser and Image Tagger agents through FastAPI and Google Apps Script webhooks.</li>
        <li>Securing services with HMAC authentication and SlowAPI rate limits; deploying on AWS EC2 with Docker and Caddy.</li>
        <li>Connecting Supabase/Postgres, Airtable, and n8n for structured data and workflow automation.</li>
      </ul>
    </article>

    <h3 class="mb-4 text-lg font-semibold text-[var(--color-text)]">Process engineering placements</h3>
    <div class="grid gap-4 md:grid-cols-2">
      {internships.map((job) => (
        <article class="rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <div class="mb-3 flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <img src={job.logo} alt={`${job.company} logo`} width="200" height="200" loading="lazy" class="h-10 w-10 rounded object-contain" />
              <div>
                <p class="font-semibold text-[var(--color-text)]">{job.company}</p>
                <p class="text-sm text-[var(--color-primary)]">{job.role}</p>
              </div>
            </div>
            <span class="whitespace-nowrap text-xs text-[var(--color-text-light)]">{job.dates}</span>
          </div>
          <p class="text-sm leading-relaxed text-[var(--color-text-light)]">{job.summary}</p>
        </article>
      ))}
    </div>

    <p class="mt-6 text-sm text-[var(--color-text-light)]">
      Additional experience includes data-informed sustainability content work at Waste Marche (Jun – Jul 2025).
    </p>
  </div>
</section>
