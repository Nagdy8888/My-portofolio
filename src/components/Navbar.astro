---
const path = Astro.url.pathname;
const workHref = path.startsWith('/projects') ? '/projects' : '/#projects';
---
<header class="site-header"><nav class="wrap header-inner" aria-label="Main navigation"><a class="wordmark" href="/" aria-label="Mustafa Alnagdy home"><span class="brand-symbol" aria-hidden="true">m<span>.</span></span><span>Mustafa Alnagdy</span></a><div class="desktop-nav"><a href={workHref} aria-current={path === '/projects' || path === '/projects/' ? 'page' : undefined}>Work</a><a href="/#about">About</a><a href="/#experience">Experience</a></div><div class="header-actions"><button type="button" id="theme-toggle" class="theme-control" aria-label="Switch color theme"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg></button><a class="header-contact" href="/#contact">Let’s talk </a><button id="menu-toggle" class="menu-control" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg></button></div></nav><div id="mobile-menu" class="mobile-navigation hidden"><a href={workHref}>Work</a><a href="/#about">About</a><a href="/#experience">Experience</a><a href="/#contact">Contact</a><a href="/Mustafa-Alnagdy-CV.pdf" download>Download CV</a></div></header>
<script>
const toggle = document.getElementById('menu-toggle');
const menu = document.getElementById('mobile-menu');
function closeMenu(returnFocus = false) { menu?.classList.add('hidden'); toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', 'Open navigation menu'); if (returnFocus) toggle?.focus(); }
toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; menu?.classList.toggle('hidden', !open); toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu'); if (open) menu?.querySelector('a')?.focus(); });
menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu()));
document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') closeMenu(true); });
window.matchMedia('(min-width: 768px)').addEventListener('change', e => { if (e.matches) closeMenu(); });
</script>
