---
import { projects, categoryToBadgeClass } from '../data/projects';

const featured = projects
  .filter((project) => project.featured)
  .sort((a, b) => (a.featuredRank ?? 99) - (b.featuredRank ?? 99))
  .slice(0, 4);
---

<section id="projects" class="py-16 md:py-20 bg-[var(--color-bg-alt)] animate-on-scroll">
  <div class="max-w-[1100px] mx-auto px-6">
    <div class="mb-8 max-w-2xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-[var(--color-primary)]">Selected work</p>
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-2">Featured case studies</h2>
      <div class="section-underline mb-5"></div>
      <p class="leading-relaxed text-[var(--color-text-light)]">
        Applied machine learning and AI systems, presented with the problem, implementation decisions,
        and the evidence currently available.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      {featured.map((project) => (
        <article class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] shadow-md transition-transform duration-200 hover:-translate-y-1">
          <a href={`/projects/${project.slug}`} class="group flex h-full flex-col">
            {project.image ? (
              <div class="aspect-[16/9] overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-bg)]">
                <img
                  src={project.image}
                  alt={project.imageAlt ?? `${project.title} interface`}
                  width={project.imageWidth ?? 1200}
                  height={project.imageHeight ?? 675}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]"
                />
              </div>
            ) : (
              <div class="project-card-visual flex aspect-[16/9] items-end border-b border-[var(--color-border)] p-5" aria-hidden="true">
                <span class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-primary)]">
                  {project.categories[0]} case study
                </span>
              </div>
            )}

            <div class="flex flex-1 flex-col p-6">
            <div class="flex flex-wrap gap-1.5 mb-3">
              {project.categories.map((cat) => (
                <span class={`inline-block text-xs font-medium px-2.5 py-1 rounded-full ${categoryToBadgeClass(cat)}`}>{cat}</span>
              ))}
            </div>
            <h3 class="font-semibold text-lg text-[var(--color-text)] mb-2">{project.title}</h3>
            <p class="text-sm text-[var(--color-text-light)] mb-2">{project.shortDescription}</p>
            {project.keyResult && <p class="mb-4 text-sm font-semibold text-[var(--color-primary)]">{project.keyResult}</p>}

            {project.metrics && project.metrics.length > 0 && (
              <dl class="mb-4 flex flex-wrap gap-x-5 gap-y-2 border-y border-[var(--color-border)] py-3">
                {project.metrics.slice(0, 2).map((metric) => (
                  <div>
                    <dt class="text-xs text-[var(--color-text-light)]">{metric.label}</dt>
                    <dd class="text-sm font-semibold text-[var(--color-text)]">{metric.value}</dd>
                  </div>
                ))}
              </dl>
            )}

            <div class="mb-5 flex flex-wrap gap-2">
              {project.tags.slice(0, 4).map((tag) => (
                <span class="tag-pill text-xs font-medium px-3 py-1 rounded-full">{tag}</span>
              ))}
              {project.tags.length > 4 && (
                <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-text-light)]">
                  +{project.tags.length - 4}
                </span>
              )}
            </div>
            <span class="mt-auto text-sm font-semibold text-[var(--color-primary)]">
              Read case study <span aria-hidden="true">→</span>
            </span>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="text-center">
      <a href="/projects" class="inline-block border-2 border-[var(--color-primary)] text-[var(--color-primary)] px-6 py-3 rounded-md font-medium hover:bg-[var(--color-primary)] hover:text-white transition-colors">
        View All Projects
      </a>
    </div>
  </div>
</section>
