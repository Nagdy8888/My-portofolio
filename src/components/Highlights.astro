---
import { projects } from '../data/projects';

const aiAgentCount = projects.filter((p) => p.categories.includes('AI Agent')).length;
---

<section class="py-10 bg-[var(--color-bg-alt)] animate-on-scroll">
  <div class="max-w-[1100px] mx-auto px-6 grid grid-cols-1 sm:grid-cols-3 gap-6">
    <div class="bg-[var(--color-surface)] rounded-md p-6 text-center border border-[var(--color-border)] shadow-md">
      <p class="text-2xl font-bold text-[var(--color-primary)]">3.65</p>
      <p class="text-sm text-[var(--color-text-light)] mt-1">Cumulative GPA</p>
    </div>
    <div class="bg-[var(--color-surface)] rounded-md p-6 text-center border border-[var(--color-border)] shadow-md">
      <p class="text-2xl font-bold text-[var(--color-primary)]">{projects.length}</p>
      <p class="text-sm text-[var(--color-text-light)] mt-1">Documented Projects</p>
    </div>
    <div class="bg-[var(--color-surface)] rounded-md p-6 text-center border border-[var(--color-border)] shadow-md">
      <p class="text-2xl font-bold text-[var(--color-primary)]">{aiAgentCount}</p>
      <p class="text-sm text-[var(--color-text-light)] mt-1">AI Agent Systems</p>
    </div>
  </div>
</section>
