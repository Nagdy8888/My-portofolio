---
const skillGroups = [
  { name: 'AI Systems', skills: ['LangGraph', 'LangChain', 'RAG', 'OpenAI APIs', 'Prompt Engineering', 'n8n Automation'] },
  { name: 'Data Science & ML', skills: ['Python', 'Pandas', 'NumPy', 'Scikit-learn', 'Regression', 'Classification', 'Anomaly Detection', 'Feature Engineering', 'Statistical Analysis'] },
  { name: 'Application & Data', skills: ['FastAPI', 'PostgreSQL', 'Supabase', 'Next.js', 'React', 'TypeScript', 'Docker'] },
  { name: 'Process Engineering', skills: ['Aspen HYSYS', 'PFD', 'P&ID', 'Process Safety'] },
  { name: 'Analysis & Delivery', skills: ['Jupyter Notebook', 'Matplotlib', 'Seaborn', 'Git', 'AutoCAD'] },
];
---

<section id="skills" class="py-16 md:py-20 bg-[var(--color-bg)] animate-on-scroll">
  <div class="max-w-[1100px] mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-2">Skills</h2>
    <div class="section-underline mb-8"></div>
    {skillGroups.map((group) => (
      <div class="mb-6">
        <h3 class="text-sm font-semibold text-[var(--color-text)] uppercase tracking-wider mb-3">{group.name}</h3>
        <div class="flex flex-wrap gap-2">
          {group.skills.map((skill) => (
            <span class="tag-pill text-sm px-3 py-1.5 rounded-md border border-[var(--color-border)]">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
